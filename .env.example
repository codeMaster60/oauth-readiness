# Required for live guide generation (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: more reliable web search from cloud servers (free tier: https://tavily.com). Falls back to DuckDuckGo.
TAVILY_API_KEY=

# Optional tuning
# GROQ_EXTRACT_MODELS=openai/gpt-oss-20b,qwen/qwen3-32b,llama-3.3-70b-versatile,openai/gpt-oss-120b
# GROQ_SYNTH_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# GROQ_TPM_PER_MODEL=7500
# DB_PATH=data/generated.sqlite3
